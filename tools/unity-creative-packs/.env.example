# Copy file này thành .env rồi điền key của Service Account.
# Tạo key: cloud.unity.com → Administration → Service accounts → New → Add Key,
# rồi cấp role Advertise API (User Acquisition) có quyền Creative Packs.
UNITY_KEY_ID=
UNITY_SECRET_KEY=

# Lấy từ link dashboard: cloud.unity.com/organizations/<ORG_ID>/acquire-v2/creative-library?app=<APP_ID>
UNITY_ORG_ID=
# App mặc định (bỏ trống để chọn app mỗi lần chạy)
UNITY_APP_ID=
